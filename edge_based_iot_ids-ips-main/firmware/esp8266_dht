#include <ESP8266WiFi.h>
#include <PubSubClient.h>

const char* ssid = "YOUR_WIFI";
const char* password = "YOUR_PSWRD";
const char* mqtt_server = "MQTT_IP";

WiFiClient espClient;
PubSubClient client(espClient);

void setup_wifi() {
  delay(10);
  Serial.println();
  Serial.print("Connecting to ");
  Serial.println(ssid);

  WiFi.begin(ssid, password);

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("");
  Serial.println("WiFi connected");
  Serial.print("IP address: ");
  Serial.println(WiFi.localIP());
}

void reconnect() {
  // Loop until we're reconnected
  while (!client.connected()) {
    Serial.print("Attempting MQTT connection to ");
    Serial.print(mqtt_server);
    Serial.print("...");
    
    // Attempt to connect
    if (client.connect("ESP8266_DHT_Client")) {
      Serial.println("connected!");
    } else {
      Serial.print("failed, rc=");
      Serial.print(client.state());
      Serial.println(" try again in 5 seconds");
      // Wait 5 seconds before retrying
      delay(5000);
    }
  }
}

void setup() {
  Serial.begin(115200);
  setup_wifi();
  client.setServer(mqtt_server, 1883);
}

void loop() {
  if (!client.connected()) {
    reconnect();
  }
  client.loop();

  // Simulated values
  float temp = random(250, 350) / 10.0;
  int pressure = random(980, 1050);

  // Build the JSON payload
  String payload = "{";
  payload += "\"device\":\"dht11\",";
  payload += "\"temperature\":" + String(temp) + ",";
  payload += "\"pressure\":" + String(pressure) + ",";
  payload += "\"ip\":\"" + WiFi.localIP().toString() + "\"";
  payload += "}";

  // This will now show up in your Serial Monitor
  Serial.print("Publishing message: ");
  Serial.println(payload);

  if (client.publish("iot/sensor", payload.c_str())) {
    Serial.println("Publish success!");
  } else {
    Serial.println("Publish failed!");
  }

  delay(5000);
}